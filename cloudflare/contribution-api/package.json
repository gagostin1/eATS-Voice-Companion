{
  "name": "eats-voice-contribution-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create eats-voice-contributions",
    "db:migrate:local": "wrangler d1 migrations apply eats-voice-contributions --local",
    "db:migrate:remote": "wrangler d1 migrations apply eats-voice-contributions --remote"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
