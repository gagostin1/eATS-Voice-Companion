{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eats-voice-contributions",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eats-voice-contributions",
      "database_id": "fae4383d-18b9-47f0-97e0-70dfea9ffe4b"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["ADMIN_TOKEN"]
  }
}
