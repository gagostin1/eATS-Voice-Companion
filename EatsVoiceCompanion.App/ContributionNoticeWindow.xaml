<Window x:Class="EatsVoiceCompanion.App.ContributionNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help improve eATS Voice Companion"
        Width="580"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="28,24" Background="#FF0F172A">
            <StackPanel>
                <TextBlock Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Text="Help us improve recognition"/>
                <TextBlock Margin="0,7,0,0"
                           Foreground="#FFBFDBFE"
                           Text="eATS Voice Companion is actively developed by Gus Agostinho."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,24,28,26">
            <TextBlock Foreground="#FF122033"
                       FontSize="15"
                       Text="Real recognition failures can become regression tests that make future releases better for everyone."
                       TextWrapping="Wrap"/>

            <Border Margin="0,18,0,0"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#FF122033"
                               FontWeight="SemiBold"
                               Text="What contribution records may contain"/>
                    <TextBlock Margin="0,9,0,0"
                               Foreground="#FF475569"
                               Text="The recognized transcript, generated command, your correction, app and model versions, and limited callsign, STAR, or route context needed to reproduce the result."
                               TextWrapping="Wrap"/>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#FF475569"
                               Text="Microphone audio, Windows usernames, local paths, and complete eATS files are not included automatically. Audio will always require separate approval."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="ParticipationCheckBox"
                      Margin="0,20,0,0"
                      VerticalContentAlignment="Center"
                      Foreground="#FF122033"
                      FontWeight="SemiBold"
                      Content="Help improve eATS Voice Companion"/>
            <TextBlock Margin="22,8,0,0"
                       Foreground="#FF64748B"
                       Text="This is enabled by default. Nothing is uploaded automatically; exported correction reports are shown for review before you share them. You can change this preference at any time in Settings."
                       TextWrapping="Wrap"/>

            <StackPanel Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Background="#FFE8EEF7"
                        Foreground="#FF122033"
                        Click="DoNotParticipate_Click"
                        Content="Don't participate"/>
                <Button Background="#FF2563EB"
                        Foreground="White"
                        Click="Continue_Click"
                        Content="Continue"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
