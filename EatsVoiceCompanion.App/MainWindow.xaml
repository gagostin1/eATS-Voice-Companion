<Window x:Class="EatsVoiceCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eATS Voice Companion"
        Width="720"
        Height="800"
        Deactivated="MainWindow_Deactivated"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="eATS Voice Companion"/>

            <TextBlock Margin="0,8,0,20"
                       Foreground="#FF555555"
                       Text="Safety-checked preview and stage-only integration"
                       TextWrapping="Wrap"/>

            <GroupBox Header="Microphone">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="MicrophoneComboBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            MinHeight="36"
                            Padding="6"
                            DisplayMemberPath="DisplayName"/>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Width="130"
                            Margin="10,0,0,0"
                            Click="RefreshMicrophones_Click"
                            Content="Refresh devices"/>

                    <TextBlock x:Name="MicrophoneStatusText"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            Foreground="#FF555555"
                            TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Recording test">
                <StackPanel Margin="12">
                    <Button x:Name="RecordButton"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Left"
                            PreviewMouseLeftButtonDown="RecordButton_MouseDown"
                            PreviewMouseLeftButtonUp="RecordButton_MouseUp"
                            Content="Hold to record"/>

                    <TextBlock x:Name="RecordingStatusText"
                            Margin="0,12,0,0"
                            Text="No recording has been made."
                            TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Speech recognition">
                <StackPanel Margin="12">
                    <TextBlock Foreground="#FF555555"
                            Text="The recording will be transcribed locally after you release the record button."
                            TextWrapping="Wrap"/>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            MinHeight="70"
                            Background="#FFF2F2F2"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBox x:Name="TranscriptText"
                                Padding="0"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="17"
                                Text="No transcript has been generated."
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Margin="0,7,0,0"
                            Foreground="#FF666666"
                            Text="You can correct the transcript, then choose Interpret again without making another recording."
                            TextWrapping="Wrap"/>

                    <TextBlock x:Name="SpeechStatusText"
                            Margin="0,10,0,0"
                            Foreground="#FF555555"
                            Text="Speech recognition has not been run."
                            TextWrapping="Wrap"/>

                    <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal">
                        <Button x:Name="InterpretTranscriptButton"
                                Width="150"
                                Height="36"
                                Click="InterpretTranscript_Click"
                                Content="Interpret again"/>

                        <Button x:Name="CancelTranscriptionButton"
                                Width="170"
                                Height="36"
                                Margin="10,0,0,0"
                                IsEnabled="False"
                                Click="CancelTranscription_Click"
                                Content="Cancel transcription"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="eATS connection">
                <StackPanel Margin="12">
                    <TextBlock Margin="0,0,0,5"
                            FontWeight="SemiBold"
                            Text="Controller position:"/>

                    <TextBox x:Name="ControllerPositionTextBox"
                            Margin="0,0,0,5"
                            Padding="7"
                            Text="Atlanta Center"/>

                    <TextBlock Margin="0,0,0,12"
                            Foreground="#FF555555"
                            Text="This exact position name may appear after the aircraft callsign."
                            TextWrapping="Wrap"/>

                    <TextBlock Margin="0,0,0,5"
                               FontWeight="SemiBold"
                               Text="eATS data directory:"/>

                    <TextBox x:Name="EatsDataDirectoryTextBox"
                             Margin="0,0,0,12"
                             Padding="7"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Text="Snapshot freshness (minutes):"/>
                            <TextBox x:Name="SnapshotFreshnessTextBox"
                                     Padding="7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Text="Keep recordings (days):"/>
                            <TextBox x:Name="RecordingRetentionTextBox"
                                     Padding="7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Text="Maximum recordings:"/>
                            <TextBox x:Name="MaximumRecordingsTextBox"
                                     Padding="7"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveSettingsButton"
                                Width="150"
                                Height="36"
                                Click="SaveSettings_Click"
                                Content="Save settings"/>

                        <Button Width="150"
                            Height="36"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            Click="DetectEats_Click"
                            Content="Detect eATS"/>
                    </StackPanel>

                    <TextBlock x:Name="SettingsStatusText"
                               Margin="0,10,0,0"
                               Foreground="#FF555555"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="#FFF2F2F2"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="StatusText"
                                   Text="Detection has not been run."
                                   TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="AirlineDataStatusText"
                            Margin="0,10,0,0"
                            Foreground="#FF555555"
                            Text="Airline data has not been loaded."
                            TextWrapping="Wrap"/>
                    <TextBlock x:Name="SnapshotStatusText"
                            Margin="0,8,0,0"
                            Foreground="#FF555555"
                            Text="Active-aircraft context has not been loaded."
                            TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Command preview">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Callsign:"/>

                    <TextBox x:Name="CallsignTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,4"
                             Padding="7"
                             Text="DAL123"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Instruction:"/>

                    <ComboBox x:Name="CommandTypeBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,4"
                              Padding="5"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Fly heading"
                                      Tag="FlyHeading"/>
                        <ComboBoxItem Content="Turn left heading"
                                      Tag="TurnLeft"/>
                        <ComboBoxItem Content="Turn right heading"
                                      Tag="TurnRight"/>
                        <ComboBoxItem Content="Climb and maintain"
                                      Tag="Climb"/>
                        <ComboBoxItem Content="Descend and maintain"
                                      Tag="Descend"/>
                        <ComboBoxItem Content="Descend via"
                                      Tag="DescendVia"/>
                        <ComboBoxItem Content="Descend via except maintain"
                                      Tag="DescendViaExceptMaintain"/>
                        <ComboBoxItem Content="Descend at pilot's discretion"
                                      Tag="PilotsDiscretion"/>
                        <ComboBoxItem Content="Expedite current altitude clearance"
                                      Tag="Expedite"/>
                        <ComboBoxItem Content="Expedite through/to altitude"
                                      Tag="ExpediteAltitude"/>
                        <ComboBoxItem Content="Report leaving altitude"
                                      Tag="ReportLeaving"/>
                        <ComboBoxItem Content="Report reaching altitude"
                                      Tag="ReportReaching"/>
                        <ComboBoxItem Content="Say altitude"
                                      Tag="SayAltitude"/>
                        <ComboBoxItem Content="Maintain speed"
                                      Tag="Speed"/>
                        <ComboBoxItem Content="Descend via; comply with published speeds at fix"
                                      Tag="PublishedSpeed"/>
                        <ComboBoxItem Content="Proceed direct"
                                      Tag="Direct"/>
                        <ComboBoxItem Content="Cross fix at altitude"
                                      Tag="CrossAltitude"/>
                        <ComboBoxItem Content="Cross fix at altitude and speed"
                                      Tag="CrossAltitudeSpeed"/>
                        <ComboBoxItem Content="Altimeter"
                                      Tag="Altimeter"/>
                        <ComboBoxItem Content="Roger / acknowledge"
                                      Tag="Roger"/>
                        <ComboBoxItem Content="Combined eATS tokens"
                                      Tag="Combined"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Value(s):"/>

                    <TextBox x:Name="CommandValueTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,4"
                             Padding="7"
                             Text="270"/>

                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                        <Button Width="150"
                                Height="36"
                                Click="BuildPreview_Click"
                                Content="Build preview"/>

                        <Button x:Name="StageCommandButton"
                                Width="170"
                                Height="36"
                                Margin="10,0,0,0"
                                Click="StageCommand_Click"
                                Content="Stage in eATS"
                                IsEnabled="False"/>
                    </StackPanel>

                    <Border Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#FF101820"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Foreground="#FFB4B4B4"
                                       Text="eATS command preview"/>

                            <TextBlock x:Name="PreviewText"
                                       Margin="0,6,0,0"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       Foreground="White"
                                       Text="No command generated."
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="PreviewErrorText"
                                       Margin="0,8,0,0"
                                       Foreground="#FFFF8A80"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CommandSafetyStatusText"
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                FontWeight="SemiBold"
                                Foreground="#FFB36B00"
                                Text="Preview only: no command has been validated."
                                TextWrapping="Wrap"/>

                    <TextBlock x:Name="CommandStageStatusText"
                               Grid.Row="6"
                               Grid.ColumnSpan="2"
                               Margin="0,8,0,0"
                               Foreground="#FF555555"
                               Text="Only a freshly verified command can be staged."
                               TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <TextBlock Margin="0,16,0,0"
                       Foreground="#FF666666"
                       Text="Staging types into eATS but never presses the final Enter key. Review every staged command before transmitting it yourself."
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
