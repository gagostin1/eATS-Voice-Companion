<Window x:Class="EatsVoiceCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eATS Voice Companion"
        Width="720"
        Height="800"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="eATS Voice Companion"/>

            <TextBlock Margin="0,8,0,20"
                       Foreground="#FF555555"
                       Text="Read-only integration and command preview"
                       TextWrapping="Wrap"/>

            <GroupBox Header="Microphone">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="MicrophoneComboBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            MinHeight="36"
                            Padding="6"
                            DisplayMemberPath="DisplayName"/>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Width="130"
                            Margin="10,0,0,0"
                            Click="RefreshMicrophones_Click"
                            Content="Refresh devices"/>

                    <TextBlock x:Name="MicrophoneStatusText"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            Foreground="#FF555555"
                            TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Recording test">
                <StackPanel Margin="12">
                    <Button x:Name="RecordButton"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Left"
                            PreviewMouseLeftButtonDown="RecordButton_MouseDown"
                            PreviewMouseLeftButtonUp="RecordButton_MouseUp"
                            Content="Hold to record"/>

                    <TextBlock x:Name="RecordingStatusText"
                            Margin="0,12,0,0"
                            Text="No recording has been made."
                            TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Speech recognition">
                <StackPanel Margin="12">
                    <TextBlock Foreground="#FF555555"
                            Text="The recording will be transcribed locally after you release the record button."
                            TextWrapping="Wrap"/>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            MinHeight="70"
                            Background="#FFF2F2F2"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="TranscriptText"
                                FontSize="17"
                                Text="No transcript has been generated."
                                TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="SpeechStatusText"
                            Margin="0,10,0,0"
                            Foreground="#FF555555"
                            Text="Speech recognition has not been run."
                            TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="eATS connection">
                <StackPanel Margin="12">
                    <Button Width="150"
                            Height="36"
                            HorizontalAlignment="Left"
                            Click="DetectEats_Click"
                            Content="Detect eATS"/>

                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="#FFF2F2F2"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="StatusText"
                                   Text="Detection has not been run."
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Header="Command preview">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Callsign:"/>

                    <TextBox x:Name="CallsignTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,4"
                             Padding="7"
                             Text="DAL123"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Instruction:"/>

                    <ComboBox x:Name="CommandTypeBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,4"
                              Padding="5"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Fly heading"
                                      Tag="FlyHeading"/>
                        <ComboBoxItem Content="Turn left heading"
                                      Tag="TurnLeft"/>
                        <ComboBoxItem Content="Turn right heading"
                                      Tag="TurnRight"/>
                        <ComboBoxItem Content="Climb and maintain"
                                      Tag="Climb"/>
                        <ComboBoxItem Content="Descend and maintain"
                                      Tag="Descend"/>
                        <ComboBoxItem Content="Maintain speed"
                                      Tag="Speed"/>
                        <ComboBoxItem Content="Proceed direct"
                                      Tag="Direct"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,7,10,7"
                               Text="Value:"/>

                    <TextBox x:Name="CommandValueTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,4"
                             Padding="7"
                             Text="270"/>

                    <Button Grid.Row="3"
                            Grid.Column="1"
                            Width="150"
                            Height="36"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Click="BuildPreview_Click"
                            Content="Build preview"/>

                    <Border Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#FF101820"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Foreground="#FFB4B4B4"
                                       Text="eATS command preview"/>

                            <TextBlock x:Name="PreviewText"
                                       Margin="0,6,0,0"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       Foreground="White"
                                       Text="No command generated."
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="PreviewErrorText"
                                       Margin="0,8,0,0"
                                       Foreground="#FFFF8A80"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <TextBlock Margin="0,16,0,0"
                       Foreground="#FF666666"
                       Text="Preview mode cannot transmit commands to eATS."
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>