<Window x:Class="EatsVoiceCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eATS Voice Companion"
        Width="920"
        Height="830"
        MinWidth="700"
        MinHeight="830"
        Background="#FFF4F7FB"
        Deactivated="MainWindow_Deactivated"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewKeyUp="MainWindow_PreviewKeyUp"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB"/>
        <SolidColorBrush x:Key="InkBrush" Color="#FF122033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF64748B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFE2E8F0"/>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
        </Style>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#FFE8EEF7"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               BasedOn="{StaticResource BaseButtonStyle}"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RecordButtonStyle"
               BasedOn="{StaticResource PrimaryButtonStyle}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="28,16"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8,8,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFF8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="30,22" Background="#FF0F172A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Text="eATS Voice Companion"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#FF94A3B8"
                               Text="Speak naturally. Verified commands stage automatically; transmission remains yours."/>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF60A5FA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Created by Gus Agostinho"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="#FF172554"
                        CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="#FF60A5FA"/>
                        <TextBlock Foreground="#FFDBEAFE"
                                   FontWeight="SemiBold"
                                   Text="LOCAL + STAGE ONLY"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="24,18,24,24"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0">
            <TabItem Header="Voice">
                <ScrollViewer Padding="2,18,2,2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Talk to eATS"/>
                                    <TextBlock Margin="0,7,0,18"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Hold while speaking, then release. The app transcribes, verifies, and stages the command automatically."
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="VoiceHotkeyHintText"
                                               Margin="0,0,0,10"
                                               Foreground="#FF1E40AF"
                                               FontWeight="SemiBold"
                                               Text="No push-to-talk hotkey assigned."
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="RecordButton"
                                            HorizontalAlignment="Left"
                                            Content="Hold to record"
                                            PreviewMouseLeftButtonDown="RecordButton_MouseDown"
                                            PreviewMouseLeftButtonUp="RecordButton_MouseUp"
                                            Style="{StaticResource RecordButtonStyle}"/>
                                    <TextBlock x:Name="RecordingStatusText"
                                               Margin="0,14,0,0"
                                               MaxHeight="42"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Ready for your first transmission."
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="220"
                                        Padding="16"
                                        VerticalAlignment="Stretch"
                                        Background="#FFEFF6FF"
                                        CornerRadius="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Foreground="#FF1E40AF" FontSize="12"
                                                   FontWeight="Bold" Text="WORKFLOW"/>
                                        <TextBlock Margin="0,9,0,0" Foreground="#FF1E3A8A"
                                                   FontWeight="SemiBold" Text="1  Record phrase"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="#FF1E3A8A"
                                                   FontWeight="SemiBold" Text="2  Verify automatically"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="#FF1E3A8A"
                                                   FontWeight="SemiBold" Text="3  Review in eATS"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="#FF1E3A8A"
                                                   FontWeight="SemiBold" Text="4  You press Enter"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Transcript"/>
                                    <TextBlock Margin="0,5,0,14"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Correct the text and interpret again if recognition needs help."
                                               TextWrapping="Wrap"/>
                                    <Border MinHeight="115" Padding="4"
                                            Background="#FFF8FAFC"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <TextBox x:Name="TranscriptText"
                                                 AcceptsReturn="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="16"
                                                 Text="No transcript has been generated."
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                    <TextBlock x:Name="SpeechStatusText"
                                               Margin="0,12,0,0"
                                               MaxHeight="42"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Speech recognition has not been run."
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                        <Button x:Name="InterpretTranscriptButton"
                                                Click="InterpretTranscript_Click"
                                                Content="Interpret again"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                        <Button x:Name="CancelTranscriptionButton"
                                                Margin="10,0,0,0"
                                                Click="CancelTranscription_Click"
                                                Content="Cancel transcription"
                                                IsEnabled="False"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Latest command"/>
                                    <TextBlock Margin="0,5,0,14"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="The final Enter key is never pressed automatically."
                                               TextWrapping="Wrap"/>
                                    <Border MinHeight="98" Padding="16"
                                            Background="#FF0B1220" CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Foreground="#FF94A3B8" FontSize="12"
                                                       FontWeight="SemiBold" Text="eATS COMMAND"/>
                                            <TextBlock x:Name="PreviewText"
                                                       Margin="0,9,0,0"
                                                       FontFamily="Consolas" FontSize="19"
                                                       Foreground="White"
                                                       Text="No command generated."
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="PreviewErrorText"
                                                       Margin="0,8,0,0"
                                                       Foreground="#FFFCA5A5"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="CommandSafetyStatusText"
                                               Margin="0,13,0,0"
                                               MaxHeight="42"
                                               FontWeight="SemiBold"
                                               Foreground="#FFB36B00"
                                               Text="Preview only: no command has been validated."
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CommandStageStatusText"
                                               Margin="0,9,0,0"
                                               MaxHeight="42"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Only a freshly verified command can be staged."
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="2,18,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Correction history"/>
                                <TextBlock Margin="0,5,18,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Review real voice attempts, preserve the intended result, and replay retained audio through the current recognizer without staging it in eATS."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="RefreshHistory_Click"
                                    Content="Refresh history"
                                    Style="{StaticResource BaseButtonStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" MinWidth="220"/>
                            <ColumnDefinition Width="1.35*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0"
                                Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           Text="Saved attempts"/>
                                <ListBox x:Name="CorrectionHistoryListBox"
                                         Grid.Row="1"
                                         Margin="0,12,0,0"
                                         BorderBrush="{StaticResource LineBrush}"
                                         DisplayMemberPath="DisplayTitle"
                                         SelectionChanged="CorrectionHistoryList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock x:Name="HistoryCountText"
                                           Grid.Row="2"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="No saved attempts yet."
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource CardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="Review selected attempt"/>
                                    <TextBlock x:Name="HistoryDetailStatusText"
                                               Margin="0,6,0,16"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Select an attempt from the history."
                                               TextWrapping="Wrap"/>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="Original transcript"/>
                                    <TextBox x:Name="HistoryOriginalTranscriptTextBox"
                                             MinHeight="76"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"/>

                                    <TextBlock Margin="0,14,0,6"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Original generated command"/>
                                    <TextBox x:Name="HistoryOriginalCommandTextBox"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"/>

                                    <TextBlock Margin="0,14,0,6"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Corrected transcript"/>
                                    <TextBox x:Name="HistoryCorrectedTranscriptTextBox"
                                             MinHeight="76"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"/>

                                    <TextBlock Margin="0,14,0,6"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Expected eATS command"/>
                                    <TextBox x:Name="HistoryExpectedCommandTextBox"
                                             FontFamily="Consolas"/>

                                    <WrapPanel Margin="0,16,0,0">
                                        <Button x:Name="MarkHistoryCorrectButton"
                                                Margin="0,0,10,10"
                                                Click="MarkHistoryCorrect_Click"
                                                Content="Mark correct"
                                                Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button x:Name="SaveHistoryCorrectionButton"
                                                Margin="0,0,10,10"
                                                Click="SaveHistoryCorrection_Click"
                                                Content="Save correction"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                        <Button x:Name="ReplayHistoryButton"
                                                Margin="0,0,10,10"
                                                Click="ReplayHistory_Click"
                                                Content="Replay through recognizer"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                        <Button x:Name="ExportHistoryButton"
                                                Margin="0,0,0,10"
                                                Click="ExportHistory_Click"
                                                Content="Export regression case"
                                                ToolTip="Enable recognition-improvement participation in Settings to export a contribution-ready case."
                                                Style="{StaticResource BaseButtonStyle}"/>
                                    </WrapPanel>

                                    <Border Margin="0,6,0,0"
                                            Padding="14"
                                            Background="#FFF8FAFC"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Text="Latest replay"/>
                                            <TextBlock x:Name="HistoryReplayResultText"
                                                       Margin="0,7,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="This attempt has not been replayed."
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Generate Command">
                <ScrollViewer Padding="2,18,2,2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,8,0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Manual command"/>
                                <TextBlock Margin="0,5,0,20"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Use this fallback when speech needs correction. A verified result follows the same automatic staging rule."
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Callsign"/>
                                <TextBox x:Name="CallsignTextBox" Margin="0,0,0,15" Text="DAL123"/>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Instruction"/>
                                <ComboBox x:Name="CommandTypeBox" Margin="0,0,0,15" SelectedIndex="0">
                                    <ComboBoxItem Content="Fly heading" Tag="FlyHeading"/>
                                    <ComboBoxItem Content="Turn left heading" Tag="TurnLeft"/>
                                    <ComboBoxItem Content="Turn right heading" Tag="TurnRight"/>
                                    <ComboBoxItem Content="Fly present heading" Tag="PresentHeading"/>
                                    <ComboBoxItem Content="Climb and maintain" Tag="Climb"/>
                                    <ComboBoxItem Content="Descend and maintain" Tag="Descend"/>
                                    <ComboBoxItem Content="Descend via" Tag="DescendVia"/>
                                    <ComboBoxItem Content="Descend via except maintain" Tag="DescendViaExceptMaintain"/>
                                    <ComboBoxItem Content="Descend at pilot's discretion" Tag="PilotsDiscretion"/>
                                    <ComboBoxItem Content="Expedite current altitude clearance" Tag="Expedite"/>
                                    <ComboBoxItem Content="Expedite through/to altitude" Tag="ExpediteAltitude"/>
                                    <ComboBoxItem Content="Report leaving altitude" Tag="ReportLeaving"/>
                                    <ComboBoxItem Content="Report reaching altitude" Tag="ReportReaching"/>
                                    <ComboBoxItem Content="Say altitude" Tag="SayAltitude"/>
                                    <ComboBoxItem Content="Maintain speed" Tag="Speed"/>
                                    <ComboBoxItem Content="Maintain speed or greater" Tag="SpeedGreater"/>
                                    <ComboBoxItem Content="Maintain speed or less" Tag="SpeedLess"/>
                                    <ComboBoxItem Content="Maintain Mach" Tag="Mach"/>
                                    <ComboBoxItem Content="Maintain Mach or greater" Tag="MachGreater"/>
                                    <ComboBoxItem Content="Maintain Mach or less" Tag="MachLess"/>
                                    <ComboBoxItem Content="Resume normal speed" Tag="ResumeNormalSpeed"/>
                                    <ComboBoxItem Content="Say indicated speed" Tag="SayIndicatedSpeed"/>
                                    <ComboBoxItem Content="Say Mach" Tag="SayMach"/>
                                    <ComboBoxItem Content="Say normal speed/Mach" Tag="SayNormalSpeed"/>
                                    <ComboBoxItem Content="Expect approach" Tag="ExpectApproach"/>
                                    <ComboBoxItem Content="Fly present heading; intercept final approach course" Tag="InterceptFinal"/>
                                    <ComboBoxItem Content="Cleared approach" Tag="ClearedApproach"/>
                                    <ComboBoxItem Content="Say approach request" Tag="SayApproachRequest"/>
                                    <ComboBoxItem Content="Cleared approach; reduce to final approach speed" Tag="ApproachSpeed"/>
                                    <ComboBoxItem Content="Contact frequency" Tag="ContactFrequency"/>
                                    <ComboBoxItem Content="Remain this frequency" Tag="RemainFrequency"/>
                                    <ComboBoxItem Content="Say again" Tag="SayAgain"/>
                                    <ComboBoxItem Content="Stand by" Tag="StandBy"/>
                                    <ComboBoxItem Content="Squawk code" Tag="SquawkCode"/>
                                    <ComboBoxItem Content="Squawk ident" Tag="SquawkIdent"/>
                                    <ComboBoxItem Content="Squawk altitude" Tag="SquawkAltitude"/>
                                    <ComboBoxItem Content="Squawk normal" Tag="SquawkNormal"/>
                                    <ComboBoxItem Content="Squawk standby" Tag="SquawkStandby"/>
                                    <ComboBoxItem Content="Squawk VFR" Tag="SquawkVfr"/>
                                    <ComboBoxItem Content="Stop altitude squawk" Tag="StopAltitudeSquawk"/>
                                    <ComboBoxItem Content="Descend via; comply with published speeds at fix" Tag="PublishedSpeed"/>
                                    <ComboBoxItem Content="Proceed direct" Tag="Direct"/>
                                    <ComboBoxItem Content="Cross fix at altitude" Tag="CrossAltitude"/>
                                    <ComboBoxItem Content="Cross fix at altitude and speed" Tag="CrossAltitudeSpeed"/>
                                    <ComboBoxItem Content="Cross distance from fix at altitude" Tag="CrossDistanceAltitude"/>
                                    <ComboBoxItem Content="Altimeter" Tag="Altimeter"/>
                                    <ComboBoxItem Content="Roger / acknowledge" Tag="Roger"/>
                                    <ComboBoxItem Content="Combined eATS tokens" Tag="Combined"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Value(s)"/>
                                <TextBox x:Name="CommandValueTextBox" Margin="0,0,0,18" Text="270"/>
                                <Button x:Name="GenerateCommandButton"
                                        HorizontalAlignment="Left"
                                        Click="BuildPreview_Click"
                                        Content="Generate command"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Command preview"/>
                                <TextBlock Margin="0,5,0,18"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Generated tokens are allowlisted and revalidated before automatic staging."
                                           TextWrapping="Wrap"/>
                                <Border MinHeight="130" Padding="18"
                                        Background="#FF0B1220" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Foreground="#FF94A3B8" FontSize="12"
                                                   FontWeight="SemiBold" Text="eATS COMMAND PREVIEW"/>
                                        <TextBlock x:Name="ManualPreviewText"
                                                   Margin="0,10,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="20"
                                                   Foreground="White"
                                                   Text="{Binding Text, ElementName=PreviewText}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ManualPreviewErrorText"
                                                   Margin="0,10,0,0"
                                                   Foreground="#FFFCA5A5"
                                                   Text="{Binding Text, ElementName=PreviewErrorText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,16,0,0" Padding="14"
                                        Background="#FFF8FAFC" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock x:Name="ManualCommandSafetyStatusText"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, ElementName=CommandSafetyStatusText}"
                                                   Text="{Binding Text, ElementName=CommandSafetyStatusText}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ManualCommandStageStatusText"
                                                   Margin="0,9,0,0"
                                                   Foreground="{Binding Foreground, ElementName=CommandStageStatusText}"
                                                   Text="{Binding Text, ElementName=CommandStageStatusText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="2,18,2,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Application settings"/>
                                <TextBlock Margin="0,5,18,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Save all audio, hotkey, automation, connection, and retention settings together."
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="SettingsStatusText"
                                           Margin="0,8,18,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="SaveSettingsButton"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    Click="SaveSettings_Click"
                                    Content="Save all settings"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="2,16,2,2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Audio input"/>
                                    <TextBlock Margin="0,5,0,18"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Choose the microphone used for hold-to-talk recording."
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Microphone"/>
                                    <ComboBox x:Name="MicrophoneComboBox" DisplayMemberPath="DisplayName"/>
                                    <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                            Click="RefreshMicrophones_Click"
                                            Content="Refresh devices"
                                            Style="{StaticResource BaseButtonStyle}"/>
                                    <TextBlock x:Name="MicrophoneStatusText"
                                               Margin="0,12,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,18,0,0"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Global push-to-talk hotkey"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PushToTalkHotkeyTextBox"
                                                 IsReadOnly="True"
                                                 Text="Not assigned"/>
                                        <Button x:Name="AssignHotkeyButton"
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Click="AssignHotkey_Click"
                                                Content="Assign"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Click="ClearHotkey_Click"
                                                Content="Clear"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                    </Grid>
                                    <TextBlock x:Name="HotkeyStatusText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Choose Assign, then press a key or key combination."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Automation"/>
                                    <TextBlock Margin="0,5,0,18"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Control how verified commands move into eATS."
                                               TextWrapping="Wrap"/>
                                    <CheckBox x:Name="AutoStageCommandsCheckBox"
                                              VerticalContentAlignment="Center"
                                              FontWeight="SemiBold"
                                              Content="Automatically stage verified commands"/>
                                    <TextBlock Margin="22,8,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="The command is typed into the eATS radio field after verification. The final Enter key is always left to you."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="eATS connection"/>
                                    <TextBlock Margin="0,5,0,20"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Configure local simulator context and recording retention."
                                               TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Controller position"/>
                                            <TextBox x:Name="ControllerPositionTextBox" Text="Atlanta Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="eATS data directory"/>
                                            <TextBox x:Name="EatsDataDirectoryTextBox"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Snapshot freshness (minutes)"/>
                                            <TextBox x:Name="SnapshotFreshnessTextBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Keep recordings (days)"/>
                                            <TextBox x:Name="RecordingRetentionTextBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Maximum recordings"/>
                                            <TextBox x:Name="MaximumRecordingsTextBox"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Margin="0,18,0,0"
                                            HorizontalAlignment="Left"
                                            Click="DetectEats_Click"
                                            Content="Detect eATS"
                                            Style="{StaticResource BaseButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connection status"/>
                                    <Border Margin="0,14,0,0" Padding="16"
                                            Background="#FFF8FAFC" CornerRadius="9">
                                        <TextBlock x:Name="StatusText"
                                                   Text="Detection has not been run."
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock x:Name="AirlineDataStatusText"
                                               Margin="0,12,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Airline data has not been loaded."
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SnapshotStatusText"
                                               Margin="0,9,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Active-aircraft context has not been loaded."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="Development feedback"/>
                                    <TextBlock Margin="0,5,0,16"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Help turn real recognition failures into regression tests that improve future releases."
                                               TextWrapping="Wrap"/>
                                    <CheckBox x:Name="RecognitionImprovementCheckBox"
                                              VerticalContentAlignment="Center"
                                              FontWeight="SemiBold"
                                              Content="Participate in recognition improvement"/>
                                    <TextBlock Margin="22,8,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Enabled by default. Nothing is uploaded automatically; exported correction reports are reviewable before sharing. Microphone audio requires separate approval."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="About eATS Voice Companion"/>
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource InkBrush}"
                                               FontWeight="SemiBold"
                                               Text="Created and maintained by Gus Agostinho."/>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="&#x00A9; 2026 Gus Agostinho. Released under the MIT License."
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="An independent, unofficial companion for eATS."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
